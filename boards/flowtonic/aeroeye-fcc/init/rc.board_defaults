#!/bin/sh
#
# board specific defaults
#------------------------------------------------------------------------------

param set-default BAT1_V_DIV 18.1
param set-default BAT2_V_DIV 18.1

param set-default BAT1_A_PER_V 36.367515152
param set-default BAT2_A_PER_V 36.367515152

# DroneCAN 파워모듈 자동 수용: 센서 + 동적 노드ID(2), 배터리 구독(raw=1).
# (UAVCAN_ENABLE 은 rcS 에서 소비되어 uavcan 을 자동 start 함 — 검증됨)
# 주의 — CAN1 트랜시버(U3 TJA1051) S 핀이 R9 풀업으로 영구 Silent 라,
#        실제 통신은 R9 제거(HW ECO) 후에야 동작. 그 전까지 노드만 미수신.
param set-default UAVCAN_ENABLE 2
param set-default UAVCAN_SUB_BAT 1
# 주: I2C 파워모니터(INA226/228/238)는 SENS_EN_* 자동시작 글루가 없어
#     rc.board_sensors 에서 명시적으로 start 한다 (param 으로 켜지 않음).

# 보드에 airspeed 센서(ELVX-L05D, I2C2) 있음. FW/VTOL 의 airspeed 프리플라이트
# 체크 활성화. MC 에서는 체크가 스킵되므로(airspeedCheck.cpp) arming 영향 없음.
param set-default SYS_HAS_NUM_ASPD 1

if ver hwtypecmp V5005000 V5005002 V5006000 V5006002
then
	# CUAV V5+ (V550/V552) and V5nano (V560/V562) have 3 IMUs
	# Multi-EKF (IMUs only)
	param set-default EKF2_MULTI_IMU 3
	param set-default SENS_IMU_MODE 0
else
	# Multi-EKF
	param set-default EKF2_MULTI_IMU 2
	param set-default SENS_IMU_MODE 0
fi

rgbled_pwm start
safety_button start
